ninja_required_version = 1.3
cxx = c++
nvcc = /usr/local/cuda-12.0/bin/nvcc

cflags = -pthread -B /home/zhengyulong/miniconda3/compiler_compat -Wno-unused-result -Wsign-compare -DNDEBUG -O2 -Wall -fPIC -O2 -isystem /home/zhengyulong/miniconda3/include -I/home/zhengyulong/miniconda3/include -fPIC -O2 -isystem /home/zhengyulong/miniconda3/include -fPIC -I/home/zhengyulong/miniconda3/lib/python3.9/site-packages/torch/include -I/home/zhengyulong/miniconda3/lib/python3.9/site-packages/torch/include/torch/csrc/api/include -I/home/zhengyulong/miniconda3/lib/python3.9/site-packages/torch/include/TH -I/home/zhengyulong/miniconda3/lib/python3.9/site-packages/torch/include/THC -I/usr/local/cuda-12.0/include -I/home/zhengyulong/miniconda3/include/python3.9 -c
post_cflags = -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=s4d_cuda_kernel -D_GLIBCXX_USE_CXX11_ABI=0 -std=c++17
cuda_cflags = -I/home/zhengyulong/miniconda3/lib/python3.9/site-packages/torch/include -I/home/zhengyulong/miniconda3/lib/python3.9/site-packages/torch/include/torch/csrc/api/include -I/home/zhengyulong/miniconda3/lib/python3.9/site-packages/torch/include/TH -I/home/zhengyulong/miniconda3/lib/python3.9/site-packages/torch/include/THC -I/usr/local/cuda-12.0/include -I/home/zhengyulong/miniconda3/include/python3.9 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=s4d_cuda_kernel -D_GLIBCXX_USE_CXX11_ABI=0 -gencode=arch=compute_80,code=compute_80 -gencode=arch=compute_80,code=sm_80 -std=c++17
cuda_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags





build /pf9550-bdp-A800/zhengyulong/lyra/s4d_cuda/build/temp.linux-x86_64-cpython-39/src/s4dkernel_kernel.o: cuda_compile /pf9550-bdp-A800/zhengyulong/lyra/s4d_cuda/src/s4dkernel_kernel.cu
build /pf9550-bdp-A800/zhengyulong/lyra/s4d_cuda/build/temp.linux-x86_64-cpython-39/src/s4dkernel_wrapper.o: compile /pf9550-bdp-A800/zhengyulong/lyra/s4d_cuda/src/s4dkernel_wrapper.cpp






